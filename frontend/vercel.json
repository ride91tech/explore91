{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "rewrites": [
    { "source": "/place/:slug", "destination": "https://explore91-api-597388632883.asia-south1.run.app/place/:slug" },
    { "source": "/city/:slug", "destination": "https://explore91-api-597388632883.asia-south1.run.app/city/:slug" },
    { "source": "/sitemap.xml", "destination": "https://explore91-api-597388632883.asia-south1.run.app/sitemap.xml" },
    { "source": "/robots.txt", "destination": "https://explore91-api-597388632883.asia-south1.run.app/robots.txt" },
    { "source": "/.well-known/:path*", "destination": "https://explore91-api-597388632883.asia-south1.run.app/.well-known/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
