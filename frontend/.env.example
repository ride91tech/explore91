EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Google OAuth client IDs, one per platform, from the Google Cloud console.
# These are public identifiers, not secrets.
# Google Sign-In. Client IDs are public (they are compiled into the app);
# never put a client *secret* here.
#
# Required on every platform. On native it is the "server" client the SDK asks
# Google to issue the ID token for; on web it is the client the browser flow
# uses, and that client needs its JavaScript origin and redirect URI
# registered in the console.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Android matches the app by package name + signing certificate rather than by
# a client ID in the app, so this is not read by the code. Keep it for
# reference: you still create one Android client per signing fingerprint
# (debug, release, and later the Play App-signing key), and every client ID
# goes in the backend's GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# iOS only.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# iOS only, and required before `expo prebuild -p ios` will include Google
# sign-in: the iOS client ID with its dot-separated parts reversed, e.g.
# com.googleusercontent.apps.123456789-abcdef. app.config.js adds the config
# plugin only when this is set, because the plugin throws without it.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
