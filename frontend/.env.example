EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Google Sign-In was removed; the app posts an email to /auth/dev instead, and
# the server decides whether that is allowed (DEV_AUTH_ENABLED). Nothing about
# sign-in is configured on the client any more. When OTP sign-in lands it will
# need a provider credential -- on the SERVER, not here: anything in this file
# is compiled into the app and readable by anyone who has it.
