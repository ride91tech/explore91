# What NOT to upload to Cloud Build.
#
# gcloud reads this file, not .dockerignore. Without it the local virtualenv
# (~300MB) gets uploaded on every deploy, which is slow and pointless — the
# image installs its own dependencies from requirements.txt.

.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# Secrets never belong in a build context.
.env
.env.*
!.env.example

# Tests run in CI, not in the runtime image.
tests/

.git/
.gitignore
*.md
deploy/

# NOTE: web/console_dist/ is deliberately NOT excluded. It is the admin
# console's web build, gitignored because it is generated, and it has to reach
# the image for /admin to serve anything.
#
# That only works because this file exists. With no .gcloudignore, gcloud
# synthesises one from .gitignore — which would exclude console_dist and
# deploy an API whose /admin returns the "not built" page, with nothing in the
# build log to say why. Do not delete this file.
