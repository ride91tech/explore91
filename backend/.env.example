MONGO_URL=mongodb://localhost:27017
DB_NAME=explore91

# Comma-separated browser origins allowed to call the API (web admin console).
# Leave blank locally; set it on any public deploy. Native apps are unaffected.
ALLOWED_ORIGINS=

# Opens POST /auth/dev, the placeholder sign-in standing in for Google until
# OTP lands. It takes an email and issues a session, verifying NOTHING -- so
# anything that can reach the server can sign in as anybody, including an
# ADMIN_EMAILS address that can then self-grant admin.
#
# Set it locally. Never on a public deploy: the route answers 404 while this
# is unset, and that is the only thing keeping the API shut.
DEV_AUTH_ENABLED=true

# Comma-separated Apple Sign-In audiences (bundle IDs / service IDs)
APPLE_AUDIENCES=

# Comma-separated emails allowed to self-grant the "admin" role via POST /auth/roles
ADMIN_EMAILS=

# Required for /ai/recommend and /ai/itinerary
ANTHROPIC_API_KEY=

# Origin the public pages build absolute URLs from (og:url, og:image,
# canonical, sitemap). Link-preview fetchers silently drop relative URLs, so
# this must be the real origin in production, e.g. https://explore91.com.
# Unset falls back to the request's own origin, which is fine locally.
PUBLIC_BASE_URL=

# --- Deep links -----------------------------------------------------------
# SHA-256 of every signing certificate whose builds should open
# https://explore91.com/place/... in the app. Comma separated, public values.
#   debug keystore:  FA:C6:17:45:DC:09:03:78:6F:B9:ED:E6:2A:96:2B:39:9F:73:48:F0:BB:6F:89:9B:83:32:66:75:91:03:3B:9C
#   upload keystore: 0C:25:01:51:33:20:9B:DB:88:9E:97:A5:D7:2E:7C:65:D3:CF:4C:CA:1B:AC:A8:64:35:89:72:ED:02:8C:30:9D
# Add the Play "App signing key" SHA-256 (Play Console > Setup > App
# integrity) before release, or links will stop working in the Play build.
ANDROID_CERT_FINGERPRINTS=

# <TeamID>.<bundleId>, e.g. ABCDE12345.com.explore91.app. Leave unset until
# there is an Apple developer account - the association file is withheld
# rather than served wrong, because iOS caches it.
IOS_APP_ID=
