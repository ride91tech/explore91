MONGO_URL=mongodb://localhost:27017
DB_NAME=explore91

# Comma-separated browser origins allowed to call the API (web admin console).
# Leave blank locally; set it on any public deploy. Native apps are unaffected.
ALLOWED_ORIGINS=

# Comma-separated Google OAuth client IDs allowed to sign in (web, android,
# ios). Tokens minted for any other client are rejected.
GOOGLE_CLIENT_IDS=

# Comma-separated Apple Sign-In audiences (bundle IDs / service IDs)
APPLE_AUDIENCES=

# Comma-separated emails allowed to self-grant the "admin" role via POST /auth/roles
ADMIN_EMAILS=

# Required for /ai/recommend and /ai/itinerary
ANTHROPIC_API_KEY=
